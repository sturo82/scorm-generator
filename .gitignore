# Dependencies
node_modules/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Test / coverage
coverage/

# Env & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Prisma generated client (regenerated)
apps/api/node_modules/.prisma/

# Local object storage (dev adapter)
.local-storage/

# Asset semantici copiati nel web public (derivati da packages/scorm, via copy-semantic)
apps/web/public/semantic/

# Bundle IIFE del renderer condiviso (generato da esbuild al build di @scorm/scorm)
packages/scorm/src/runtime/assets/render-core.js

# Pacchetti SCORM esportati (artefatti di build, non versionati)
exports/

# Terraform: state (può contenere segreti), lock, cache provider, tfvars reali
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
infra/terraform/terraform.tfvars
crash.log

# Zip di esempio Brain-Bites nella root (duplicato in examples/; artefatto)
/Brain-Bites-Covid-19-and-Healthy-Workspaces.zip

# Libreria sorgente dei loghi dell'ecosistema (input di design, non artefatto):
# gli asset effettivamente usati sono copiati in apps/web/public/brand/ e infra/.
/Prodotti Knowkube/
