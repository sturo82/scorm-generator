{
  "name": "@scorm/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-semantic": "mkdir -p public/semantic && cp -r ../../packages/scorm/src/runtime/assets/semantic/. public/semantic/ && cp ../../packages/scorm/src/runtime/assets/semantic-runtime.js public/semantic/",
    "predev": "npm run copy-semantic",
    "prebuild": "npm run copy-semantic",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@scorm/contracts": "0.1.0",
    "@tanstack/react-query": "5.32.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "@radix-ui/react-slot": "1.0.2",
    "lucide-react": "0.372.0",
    "next": "14.2.3",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.51.3",
    "@hookform/resolvers": "3.3.4",
    "tailwind-merge": "2.3.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "tailwindcss-animate": "1.0.7",
    "eslint-config-next": "14.2.3",
    "@playwright/test": "1.44.0"
  }
}
