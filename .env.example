# Copiare in .env e adattare. NON committare .env con segreti reali.

# API
PORT=3000

# Database (Postgres + pgvector). In Dev Container l'host è "db".
DATABASE_URL=postgresql://scorm:scorm_dev_password@localhost:5432/scorm

# Selezione provider (Requisito 10.4). Default: mock/in-memory per sviluppo.
PROVIDER_LLM=mock
PROVIDER_EMBEDDINGS=mock
PROVIDER_VECTOR_STORE=in-memory
PROVIDER_OBJECT_STORAGE=local
PROVIDER_JOB_QUEUE=in-memory

# Coda SQS (quando PROVIDER_JOB_QUEUE=sqs). In dev si può puntare a LocalStack.
SQS_QUEUE_URL=
SQS_REGION=us-east-1
# SQS_ENDPOINT=http://localhost:4566

# Auth. 'dev' accetta il token statico "dev-token" del frontend e auto-provisiona
# tenant/utente (SOLO sviluppo). 'jwt' usa HS256. 'oidc' valida i token di un IdP.
AUTH_PROVIDER=jwt
AUTH_JWT_SECRET=dev-insecure-secret-change-me
AUTH_JWT_ISSUER=scorm-generator
AUTH_JWT_AUDIENCE=scorm-api

# Amazon Cognito — gestione utenti admin (inviti dal pannello Utenti).
# Richiesto in produzione quando si usano gli inviti; se assente, l'endpoint
# POST /admin/users risponde 501 (dev/test restano senza Cognito).
# Le credenziali AWS vengono dal task role IAM (default credential chain).
# COGNITO_USER_POOL_ID=eu-west-1_abc123XYZ
# COGNITO_REGION=eu-west-1   # default = AWS_REGION

# OIDC (quando AUTH_PROVIDER=oidc): validazione token via JWKS dell'IdP.
# OIDC_ISSUER=https://your-idp.example.com/
# OIDC_AUDIENCE=scorm-api
# OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json   # opzionale: derivato da OIDC_ISSUER se omesso
# OIDC_TENANT_CLAIM=custom:tenant_id,tenant_id   # claim del tenant (CSV, provati in ordine)
# OIDC_TOKEN_USE=access   # Cognito: impone token_use ("access" | "id")
#
# --- Esempio Amazon Cognito (user pool) ---
# ISSUER = https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# L'access token di Cognito non ha "aud" ma "client_id": OIDC_AUDIENCE va
# confrontato con client_id (gestito automaticamente). Il tenant va aggiunto
# come custom attribute (custom:tenant_id) nel user pool.
# OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_abc123XYZ
# OIDC_AUDIENCE=<app-client-id>
# OIDC_TOKEN_USE=access
# OIDC_TENANT_CLAIM=custom:tenant_id

# Origini CORS consentite per il frontend (CSV).
CORS_ORIGINS=http://localhost:3100

# Amazon Bedrock (quando PROVIDER_LLM=bedrock e/o PROVIDER_EMBEDDINGS=bedrock).
# Le credenziali NON vanno committate: usare .env (gia in .gitignore) o la
# default credential chain AWS (ruolo IAM, profilo, ecc.).
# us-west-2 ospita LLM (Claude), immagini (Stable Image) e audio (Polly) insieme.
BEDROCK_REGION=us-west-2
# NB: i modelli Anthropic su Bedrock richiedono un INFERENCE PROFILE (prefisso di
# regione, es. "us."), non il model id "nudo". Verifica gli ID attivi sul tuo
# account con: aws bedrock list-inference-profiles.
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBEDDINGS_MODEL_ID=amazon.titan-embed-text-v2:0
# Se PROVIDER_EMBEDDINGS=bedrock, allineare EMBEDDINGS_DIMENSIONS al modello
# (es. 1024 per titan-embed-text-v2) e rigenerare gli embeddings esistenti.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...

# Generazione media: immagini (Stability su Bedrock) e audio (Amazon Polly).
# Default mock (nessuna chiamata/costo). Attivare i reali con i provider sotto.
PROVIDER_IMAGE=mock          # mock | bedrock (Stability Stable Image Core)
PROVIDER_SPEECH=mock         # mock | polly
PROVIDER_TRANSCRIPTION=mock  # mock | transcribe (Amazon Transcribe, trascrizione video ASR)
# Regione di Amazon Transcribe (default = AWS_REGION). Il video caricato su S3
# viene trascritto con timestamp per la trascrizione sincronizzata (karaoke).
# TRANSCRIBE_REGION=us-east-1
# TRANSCRIBE_LANGUAGE=it-IT   # lingua attesa; se assente, auto-detect
# Regione dei modelli media (default = BEDROCK_REGION). Stable Image Core/Ultra
# e Polly sono disponibili in us-west-2.
# MEDIA_REGION=us-west-2
# IMAGE_MODEL_ID=stability.stable-image-core-v1:1
#   Alternative (qualita/testo migliori, costo maggiore):
#   stability.sd3-5-large-v1:0        (SD 3.5 Large, buon testo)
#   stability.stable-image-ultra-v1:1 (massima qualita)
#   NB: l'app istruisce comunque i prompt a NON inserire testo nelle immagini.
# IMAGE_FORMAT=jpeg          # jpeg|png|webp (jpeg = pacchetti SCORM piu leggeri)
# IMAGE_WIDTH=1024
# IMAGE_HEIGHT=768
# SPEECH_ENGINE=neural       # neural|standard
# SPEECH_DEFAULT_VOICE=Bianca   # voce Polly di default (override per lingua)
# NB: Stable Image filtra i prompt NON in inglese; l'app traduce automaticamente
# i prompt immagine in inglese via LLM prima della generazione.

# ---------------------------------------------------------------------------
# Frontend (apps/web) — variabili pubbliche Next.js (build-time, visibili al browser).
# NON mettere qui segreti: il client OIDC usa PKCE e non ha client secret.
# ---------------------------------------------------------------------------
# API: 'mock' (default, UI senza backend) oppure 'real'.
# NEXT_PUBLIC_API_MODE=real
# NEXT_PUBLIC_API_URL=http://localhost:3000
#
# Auth: 'oidc' abilita il flusso Authorization Code + PKCE verso l'IdP; se omesso
# resta il login mock di sviluppo.
# NEXT_PUBLIC_AUTH_MODE=oidc
# NEXT_PUBLIC_OIDC_ISSUER=https://your-idp.example.com
# NEXT_PUBLIC_OIDC_CLIENT_ID=your-spa-client-id
# NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3100/auth/callback
# NEXT_PUBLIC_OIDC_SCOPE=openid profile email
# NEXT_PUBLIC_OIDC_AUDIENCE=scorm-api
#
# --- Esempio Amazon Cognito ---
# ISSUER = user pool endpoint; il client scopre authorize/token endpoint dal
# discovery (.well-known/openid-configuration), che puntano al dominio hosted UI.
# Nel user pool: abilita Authorization code grant + PKCE, scope openid/email,
# e registra la callback URL http://localhost:3100/auth/callback.
# NEXT_PUBLIC_AUTH_MODE=oidc
# NEXT_PUBLIC_OIDC_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_abc123XYZ
# NEXT_PUBLIC_OIDC_CLIENT_ID=<app-client-id>
# NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3100/auth/callback
# NEXT_PUBLIC_OIDC_SCOPE=openid email profile

# Object storage S3-compatibile (LocalStack in dev)
S3_ENDPOINT=http://localhost:4566
# Endpoint pubblico per gli URL firmati (browser). Serve quando l'API gira in un
# container e usa un endpoint interno non risolvibile dal browser. Dentro Docker:
# S3_ENDPOINT=http://localstack:4566 e S3_PUBLIC_ENDPOINT=http://localhost:4566.
# In produzione (S3 reale) lasciare entrambi vuoti.
# S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=scorm-dev
