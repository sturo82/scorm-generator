# Copia in terraform.tfvars e adatta. I valori qui sono per il deploy di
# produzione su knowkube.com.

project = "scorm"
region  = "eu-west-1"

route53_zone_name = "knowkube.com"
web_domain        = "architect.knowkube.com"
api_domain        = "api.architect.knowkube.com"
# Dominio custom della login Cognito (ecosistema admin). Vuoto = non creato.
auth_domain       = "auth.knowkube.com"

# Bedrock: LLM in Irlanda (inference profile EU), immagini in us-west-2 (Oregon).
# Valori verificati come disponibili/ACTIVE su questo account.
media_region         = "us-west-2"
bedrock_llm_model_id = "eu.anthropic.claude-sonnet-4-6"
image_model_id       = "stability.stable-image-core-v1:1"

# Budget
db_instance_class = "db.t4g.micro"
apprunner_cpu     = "1024"
apprunner_memory  = "2048"

stock_image_provider = "unsplash"

# Impostati dalla CI a ogni deploy (tag immagine). In locale lascia "latest".
api_image_tag = "latest"
web_image_tag = "latest"
